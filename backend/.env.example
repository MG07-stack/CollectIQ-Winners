# PostgreSQL Database URL
# Example: postgresql://postgres:postgres@localhost:5432/collectiq
# If left blank, defaults to local SQLite: sqlite:///./collectiq.db
DATABASE_URL=

# JWT Authentication Secret Key
SECRET_KEY=collectiq_super_secret_jwt_key_2026_change_in_production_998877

# JWT Algorithm
ALGORITHM=HS256

# JWT Token Expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server port
PORT=8000
